<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/button_fill_pressed" />
            <stroke android:width="1.5dp" android:color="@color/gold" />
            <corners android:radius="12dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/button_fill" />
            <stroke android:width="1.5dp" android:color="@color/gold_dark" />
            <corners android:radius="12dp" />
        </shape>
    </item>
</selector>
